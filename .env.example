# Local backend settings (Java properties syntax: no surrounding quotes).
SERVER_PORT=8080
# Docker mapping 3307:3306 means the host connects to port 3307.
DB_URL=jdbc:mysql://127.0.0.1:3307/achat?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=
# Generate a unique local secret; production requires 64+ characters and the prod profile.

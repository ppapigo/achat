map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
limit_req_zone $binary_remote_addr zone=achat_requests:10m rate=30r/s;

server {
    listen 8080;
    server_name achat.grooverapp.com;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;
    limit_req zone=achat_requests burst=60 nodelay;
    limit_req_status 429;
    # Trust only the existing Caddy address. Caddy overwrites X-Real-IP.
    set_real_ip_from ${CADDY_TRUSTED_CIDR};
    real_ip_header X-Real-IP;
    real_ip_recursive off;
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://achat.grooverapp.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location = /healthz { access_log off; return 200 'ok'; }
    location = /backend/health { return 404; }
    location /backend/ {
        proxy_pass http://backend:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }
    # Compatibility for clients explicitly configured with the public /ws endpoint.
    location = /ws {
        proxy_pass http://backend:8080/ws;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
    location / { try_files $uri $uri/ /index.html; }
}

# Copy to .env.prod (gitignored), chmod 600. Do not use example values in production.
ACHAT_RELEASE=security-20261020
MYSQL_DATABASE=achat
MYSQL_USER=achat_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
# Existing AChat-only volume; never a MOA/Groover volume.
ACHAT_MYSQL_VOLUME=
# Existing Caddy container's proxy-net IPv4 address, with /32.
CADDY_TRUSTED_CIDR=
# Choose an unused subnet after inspecting existing Docker networks.
ACHAT_APP_SUBNET=172.30.240.0/24
ACHAT_FRONT_INTERNAL_IP=172.30.240.10
